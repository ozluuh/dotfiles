{{ template "file_title" "Define the bare minimum shell alias" }}
{{ template "file_location" . }}
#---------- Default -------------------------------------------------#
# mask built-ins with better defaults/configs
alias ping='ping -c 5'
alias ls='ls --color=auto'
alias grep='grep --color=auto'
#---------- Typos ---------------------------------------------------#
alias zz='exit'
alias quit='exit'
alias sh-reload="exec ${SHELL_BASENAME}"
alias sh-reload-profiler="SHELL_PROFILER=true exec ${SHELL_BASENAME}"
alias sh-reload-verbose="SHELL_VERBOSITY=3 exec ${SHELL_BASENAME}"
alias ..="cd .."
alias cd..="cd .."
#---------- Terminal ------------------------------------------------#
alias permissions="stat -c '%a %n'"
#---------- External ------------------------------------------------#
if is_directory "${SHELL_ALIAS_DIR}"; then
  for file in ${SHELL_ALIAS_DIR}/*; do
    try_load_file "${file}"
  done
fi
#--------------------------------------------------------------------#
