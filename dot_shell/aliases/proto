! command_exists "proto" && return
plm() { proto; }
plm-status() { proto status; }
plm-status-global() { proto status --config-mode all; }
plm-diagnose() { proto diagnose; }
plm-init() { proto regen --bin; }
plm-add() { proto install ${@}; }
plm-del() { proto uninstall ${@}; }
plm-pin() { proto pin "${1}" "${2}"; }
plm-add-plugin() { proto plugin add "${1}" "${2}"; }
