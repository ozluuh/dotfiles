{{ template "file_title" }}
{{ template "file_location" . }}
try_load_file "${ZINIT_HOME}/zinit.zsh"
if is_not_empty_string "${ZINIT}"; then
  debug "$(purple "Action->Loaded"): '$(orange "zinit")' found."
fi
