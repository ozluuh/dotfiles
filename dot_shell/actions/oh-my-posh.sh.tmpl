{{ $cmd := "oh-my-posh" }}
{{ $filename := list "${XDG_CONFIG_HOME}" $cmd "theme.omp.json" | join .chezmoi.pathSeparator }}
! command_exists "{{ $cmd }}" && return
is_equal_string "${TERM_PROGRAM}" "Apple_Terminal" && return
if ! is_bash && ! is_zsh; then
    return
fi
if ! is_file "{{ $filename }}"; then
    eval "$({{ $cmd }} init ${SHELL_BASENAME})"
    return
fi
eval "$({{ $cmd }} init ${SHELL_BASENAME} --config {{ $filename }})"
