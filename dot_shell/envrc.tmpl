{{ template "file_title" "Define the bare minimum environments variables" }}
{{ template "file_location" . }}
#---------- Shell ---------------------------------------------------#
# To show functions logs
# [0: supress all (except critical/important/message)]
# [1: success/error]
# [2: +warn
# [3: +debug]
export SHELL_VERBOSITY=${SHELL_VERBOSITY:-2}

export SHELL_DIR="${SHELL_DIR:-"${HOME}/.shell"}"
export SHELL_ALIAS_DIR="${SHELL_DIR}/aliases"
export SHELL_ENV_DIR="${SHELL_DIR}/envs"
export SHELL_ACTION_DIR="${SHELL_DIR}/actions" # where shell's store load actions
export SHELL_HEADER_DIR="${SHELL_DIR}/headers"
export SHELL_FOOTER_DIR="${SHELL_DIR}/footers"
export SHELL_SHELLS_HOME="${SHELL_DIR}/shells"

# Cache to avoid calling repeatedly
export SHELL_BASENAME="$(basename "$(ps -p $$ -ocmd=)")"
#---------- Default -------------------------------------------------#
export LANG='en_US.UTF-8'
# Setting LC_ALL overrides all other LC_* variables.
# LANG is kept as a fallback.
export LC_ALL='en_US.UTF-8'
export LESSCHARSET='utf-8'

# Cache the architecture check to avoid calling `uname` repeatedly
export ARCH="${ARCH:-"$(uname -m)"}"
export ARCHFLAGS="-arch ${ARCH}"

export XDG_BIN_HOME="${XDG_BIN_HOME:-"${HOME}/.local/bin"}"
export XDG_CACHE_HOME="${XDG_CACHE_HOME:-"${HOME}/.cache"}"
export XDG_CONFIG_HOME="${XDG_CONFIG_HOME:-"${HOME}/.config"}"
export XDG_DATA_HOME="${XDG_DATA_HOME:-"${HOME}/.local/share"}"
export XDG_STATE_HOME="${XDG_STATE_HOME:-"${HOME}/.local/state"}"

export XDG_DESKTOP_DIR="${XDG_DESKTOP_DIR:-"${HOME}/Desktop"}"
export XDG_DOWNLOAD_DIR="${XDG_DOWNLOAD_DIR:-"${HOME}/Downloads"}"
export XDG_TEMPLATES_DIR="${XDG_TEMPLATES_DIR:-"${HOME}/Templates"}"
export XDG_PUBLICSHARE_DIR="${XDG_PUBLICSHARE_DIR:-"${HOME}/Public"}"
export XDG_DOCUMENTS_DIR="${XDG_DOCUMENTS_DIR:-"${HOME}/Documents"}"
export XDG_MUSIC_DIR="${XDG_MUSIC_DIR:-"${HOME}/Music"}"
export XDG_PICTURES_DIR="${XDG_PICTURES_DIR:-"${HOME}/Pictures"}"
export XDG_VIDEOS_DIR="${XDG_VIDEOS_DIR:-"${HOME}/Videos"}"

export PATH="${XDG_BIN_HOME}:${PATH}"
#--------------------------------------------------------------------#
