# Makes curl perform its transfers in parallel
parallel-immediate

# Show progress bar
# -#
progress-bar

# Fail fast with no output on HTTP errors
# -f
fail

# Follow redirects
# -L
location

# Silent mode
# -s
silent

# Show error even when `silent` is used
# -S
show-error

# Set maximum time allowed for the transfer in seconds
max-time 150

# Set the max time allowed during retries in seconds
retry-max-time 60

# Number of retries to perform
retry 3

# Max time between retries in seconds
retry-delay 5
